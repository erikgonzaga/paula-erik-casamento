NEXT_PUBLIC_SUPABASE_URL=
# URL usada exclusivamente pelo servidor. Se definida, ela prevalece sobre a variável pública.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Nunca prefixar com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITATION_SESSION_SECRET=
# Origem pública exata, sem caminho. Em desenvolvimento:
APP_ORIGIN=http://localhost:3000
# Temporário: use INVITATION_ACCESS_DEBUG=1 somente durante o diagnóstico no servidor.
INVITATION_ACCESS_DEBUG=
# Mercado Pago Checkout Transparente via Orders. Somente no servidor.
# PAYMENTS_ENVIRONMENT é obrigatório e falha fechado se não for test/production.
# O token configurado deve corresponder ao mesmo ambiente.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_APPLICATION_ID=
MERCADO_PAGO_USER_ID=
PAYMENTS_ENVIRONMENT=test
# Segredo dedicado da rota interna de reconciliação; mínimo de 32 caracteres.
# Configurar o mesmo valor no ambiente Next.js e no Supabase Vault após o deploy.
PAYMENT_RECONCILIATION_SECRET=
